:name: Nucleo H563ZI
:description: Issue #915 — comprehensive STM32H563 bare-metal firmware tests

$name?="Nucleo H563ZI"
$bin?=@artifacts/basic_peripheral_test.elf

using sysbus
mach create $name
machine LoadPlatformDescription @platforms/boards/nucleo_h563zi.repl

showAnalyzer usart3

macro reset
"""
    sysbus LoadELF $bin
"""
runMacro $reset
